    function speakHindiBeat(text, speakerLabel) {
      if (!audioEnabled || !('speechSynthesis' in window)) return;
      try {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = 'hi-IN';

        const voices = window.speechSynthesis.getVoices();
        const hindiVoice = voices.find(v => v.lang && v.lang.toLowerCase().includes('hi')) ||
                           voices.find(v => v.name && v.name.toLowerCase().includes('hindi'));
        if (hindiVoice) {
          utter.voice = hindiVoice;
        }

        if (speakerLabel.includes('तांत्रिक') || speakerLabel.includes('ठाकुर')) {
          utter.pitch = 0.72;
          utter.rate = 0.88;
        } else if (speakerLabel.includes('चौकीदार')) {
          utter.pitch = 0.82;
          utter.rate = 0.86;
        } else if (speakerLabel.includes('रुक्मिणी') || speakerLabel.includes('पिशाचिनी')) {
          utter.pitch = 1.18;
          utter.rate = 0.88;
        } else {
          utter.pitch = 0.92;
          utter.rate = 0.92;
        }

        window.speechSynthesis.speak(utter);

        if (ttsKeepAliveId) clearInterval(ttsKeepAliveId);
        ttsKeepAliveId = setInterval(() => {
          if (window.speechSynthesis && window.speechSynthesis.speaking && !window.speechSynthesis.paused) {
            window.speechSynthesis.pause();
            window.speechSynthesis.resume();
          }
        }, 4500);
      } catch (e) {}
    }

    // ==================== STORY ENGINE & PER-DIALOGUE SHOT SWITCHER ====================
    function renderChapterPills() {
      const container = document.getElementById('chapter-pills-container');
      container.innerHTML = '';
      CHAPTERS.forEach((ch, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isActive = idx === currentChapterIndex;
        btn.className = isActive
          ? 'px-1.5 py-1.5 rounded-lg text-[11px] font-bold bg-red-700 text-white border border-red-400 shadow transition truncate'
          : 'px-1.5 py-1.5 rounded-lg text-[11px] font-medium bg-stone-900/90 text-stone-300 border border-stone-800 hover:border-red-800 transition truncate';
        btn.textContent = ch.shortTitle;
        btn.addEventListener('click', () => {
          jumpToChapter(idx);
        });
        container.appendChild(btn);
      });
    }

    function renderBeatDots() {
      const dotsContainer = document.getElementById('scene-beat-dots');
      dotsContainer.innerHTML = '';
      const chapter = CHAPTERS[currentChapterIndex];
      chapter.beats.forEach((b, bIdx) => {
        const pill = document.createElement('button');
        pill.type = 'button';
        const isCurrent = bIdx === currentBeatIndex;
        const globalShotNum = currentChapterIndex * 4 + bIdx + 1;
        pill.className = isCurrent
          ? 'px-2 py-0.5 rounded bg-amber-500 text-black font-extrabold text-[10px] shadow transition'
          : 'px-2 py-0.5 rounded bg-stone-900 text-stone-400 border border-stone-700 hover:border-amber-600 text-[10px] font-semibold transition';
        pill.textContent = `शॉट ${globalShotNum}`;
        pill.addEventListener('click', () => {
          currentBeatIndex = bIdx;
          if (!hasStartedOnce) {
            hasStartedOnce = true;
            document.getElementById('start-cutscene-overlay').classList.add('hidden');
          }
          ensureAudioContext();
          isPlaying = true;
          updatePlayPauseButton();
          loadCurrentBeat(true);
          startBeatLoop();
        });
        dotsContainer.appendChild(pill);
      });
    }

    function loadCurrentBeat(triggerVoice = true) {
      const chapter = CHAPTERS[currentChapterIndex];
      const beat = chapter.beats[currentBeatIndex];
      const globalShotNum = currentChapterIndex * 4 + currentBeatIndex + 1;

      // Trigger crisp film-cut visual flash so every dialogue transition feels like a movie cut
      shotCutTransitionAlpha = 0.72;

      document.getElementById('hud-chapter-time').textContent = `${chapter.timeRange} • सीन ${chapter.id}/10`;
      document.getElementById('hud-shot-badge').textContent = `🎥 ${beat.shotDesc}`;
      document.getElementById('hud-chapter-title').textContent = chapter.title;
      document.getElementById('story-timer-badge').textContent = `सीन ${chapter.id}/10 • शॉट ${globalShotNum}/40`;
      document.getElementById('speaker-badge').textContent = beat.speaker;
      document.getElementById('sfx-indicator').textContent = beat.sfx;
      document.getElementById('beat-counter-label').textContent = `संवाद ${currentBeatIndex + 1} / ${chapter.beats.length}`;
      document.getElementById('subtitle-hindi-text').textContent = beat.text;
      document.getElementById('beat-progress-bar').style.width = '0%';

      renderChapterPills();
      renderBeatDots();

      const charCount = beat.text.length;
      beatDurationMs = slowHorrorPace
        ? Math.max(9200, charCount * 90)
        : Math.max(5000, charCount * 50);
      beatElapsedMs = 0;

      // Trigger per-dialogue horror sound effects matching the exact line
      if (triggerVoice && isPlaying) {
        if (beat.beatOverlay === 'red_bride_headlights' || beat.beatOverlay === 'payal_blood_glow' || beat.beatOverlay === 'sonar_eyes_pulse') {
          playPayalChime();
        }
        if (beat.beatOverlay === 'rain_lightning' || beat.beatOverlay === 'red_curse_vignette' || beat.beatOverlay === 'well_red_vortex') {
          playThunderCrash();
        }
        if (beat.beatOverlay === 'gate_slam_sparks' || beat.beatOverlay === 'slab_closing_shadow') {
          playIronGateSlam();
        }
        if (beat.beatOverlay === 'climax_jumpscare') {
          playJumpScareScream();
        }
        speakHindiBeat(beat.text, beat.speaker);
      }
    }

    function startBeatLoop() {
      if (beatIntervalId) clearInterval(beatIntervalId);
      beatIntervalId = setInterval(() => {
        if (!isPlaying) return;
        beatElapsedMs += 100;
        const pct = Math.min(100, (beatElapsedMs / beatDurationMs) * 100);
        const bar = document.getElementById('beat-progress-bar');
        if (bar) bar.style.width = `${pct}%`;

        const speechDone = !('speechSynthesis' in window) || !window.speechSynthesis.speaking;
        if (beatElapsedMs >= beatDurationMs || (speechDone && beatElapsedMs >= beatDurationMs * 0.72)) {
          advanceToNextBeat();
        }
      }, 100);
    }

    function advanceToNextBeat() {
      const chapter = CHAPTERS[currentChapterIndex];
      if (currentBeatIndex < chapter.beats.length - 1) {
        currentBeatIndex++;
        loadCurrentBeat(true);
      } else if (currentChapterIndex < CHAPTERS.length - 1) {
        currentChapterIndex++;
        currentBeatIndex = 0;
        loadCurrentBeat(true);
      } else {
        playJumpScareScream();
        isPlaying = false;
        updatePlayPauseButton();
        showToast('🎬 पूरे 40 शॉट्स की स्टोरी पूरी हुई! अब 4-प्लेयर ठाकुर हवेली लॉबी खुल रही है...');
        setTimeout(() => {
          switchView('lobby');
        }, 1600);
      }
    }

    function goToPreviousBeat() {
      if (currentBeatIndex > 0) {
        currentBeatIndex--;
      } else if (currentChapterIndex > 0) {
        currentChapterIndex--;
        currentBeatIndex = CHAPTERS[currentChapterIndex].beats.length - 1;
      } else {
        currentChapterIndex = 0;
        currentBeatIndex = 0;
      }
      if (!hasStartedOnce) {
        hasStartedOnce = true;
        document.getElementById('start-cutscene-overlay').classList.add('hidden');
      }
      ensureAudioContext();
      isPlaying = true;
      updatePlayPauseButton();
      loadCurrentBeat(true);
      startBeatLoop();
    }

    function jumpToChapter(chapterIdx) {
      currentChapterIndex = Math.max(0, Math.min(CHAPTERS.length - 1, chapterIdx));
      currentBeatIndex = 0;
      if (!hasStartedOnce) {
        hasStartedOnce = true;
        document.getElementById('start-cutscene-overlay').classList.add('hidden');
      }
      isPlaying = true;
      ensureAudioContext();
      updatePlayPauseButton();
      loadCurrentBeat(true);
      startBeatLoop();
    }

    function updatePlayPauseButton() {
      const btn = document.getElementById('play-pause-btn');
      if (isPlaying) {
        btn.innerHTML = '⏸️ रोकें (Pause)';
        btn.className = 'px-4 py-1.5 rounded-lg bg-red-700 hover:bg-red-600 text-white text-xs sm:text-sm font-bold transition';
      } else {
        btn.innerHTML = '▶️ चलाएं (Play)';
        btn.className = 'px-4 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white text-xs sm:text-sm font-bold transition';
      }
    }

    // ==================== 2.5D PER-DIALOGUE SHOT & ANIMATION ENGINE ====================
    const canvas = document.getElementById('horror-canvas');
    const ctx2d = canvas.getContext('2d');
    let animFrameId = null;
    let frameTick = 0;

    const rainDrops = Array.from({ length: 110 }, () => ({
      x: Math.random(),
      y: Math.random(),
      len: 12 + Math.random() * 18,
      speed: 0.018 + Math.random() * 0.015
    }));

    const fireEmbers = Array.from({ length: 65 }, () => ({
      x: 0.2 + Math.random() * 0.6,
      y: 0.4 + Math.random() * 0.6,
      r: 1.5 + Math.random() * 3.4,
      vy: 0.003 + Math.random() * 0.006,
      vx: (Math.random() - 0.5) * 0.003,
      alpha: 0.45 + Math.random() * 0.55
    }));

    const smokePuffs = Array.from({ length: 24 }, (_, idx) => ({
      x: 0.25 + (idx % 6) * 0.1,
      y: 0.72 + Math.random() * 0.15,
      r: 18 + Math.random() * 26,
      vy: 0.0018 + Math.random() * 0.002
    }));

    const soundRings = [0, 0.33, 0.66];

    function resizeCanvas() {
      const wrapper = document.getElementById('cutscene-stage-wrapper');
      if (!wrapper) return;
      const rect = wrapper.getBoundingClientRect();
      canvas.width = Math.max(640, Math.floor(rect.width));
      canvas.height = Math.max(360, Math.floor(rect.height));
    }

    function drawHorrorCutsceneFrame() {
      frameTick++;
      const w = canvas.width;
      const h = canvas.height;
      const chapter = CHAPTERS[currentChapterIndex];
      const beat = chapter.beats[currentBeatIndex];
      const imgEl = document.getElementById(beat.artId);

      ctx2d.clearRect(0, 0, w, h);

      // Progress 0..1 within current dialogue beat
      const beatProg = Math.min(1, beatElapsedMs / Math.max(1000, beatDurationMs));
      const cam = beat.cam || { fx: 0.5, fy: 0.5, z0: 1.04, z1: 1.15, panX: 0.01, panY: 0.0 };

      // Interpolate per-dialogue camera zoom and focal center so each beat has a unique camera angle
      const currentZoom = cam.z0 + (cam.z1 - cam.z0) * beatProg + Math.sin(frameTick * 0.01) * 0.012;
      const offsetX = (0.5 - cam.fx) * w * (currentZoom - 1) + (cam.panX * w * beatProg);
      const offsetY = (0.5 - cam.fy) * h * (currentZoom - 1) + (cam.panY * h * beatProg);

      const shakeX = (jumpScareFlashTimer > 0 || beat.beatOverlay === 'red_bride_headlights')
        ? (Math.random() - 0.5) * (jumpScareFlashTimer > 0 ? 28 : 6)
        : 0;
      const shakeY = (jumpScareFlashTimer > 0 || beat.beatOverlay === 'red_bride_headlights')
        ? (Math.random() - 0.5) * (jumpScareFlashTimer > 0 ? 28 : 6)
        : 0;

      // Dizzy tilt on poisoned milk beat (Beat 5.3)
      const tiltAngle = beat.beatOverlay === 'poison_dizzy_wave'
        ? Math.sin(frameTick * 0.06) * 0.055
        : 0;

      ctx2d.save();
      ctx2d.translate(w / 2 + offsetX + shakeX, h / 2 + offsetY + shakeY);
      if (tiltAngle !== 0) ctx2d.rotate(tiltAngle);
      ctx2d.scale(currentZoom, currentZoom);
      if (imgEl && imgEl.complete && imgEl.naturalWidth > 0) {
        ctx2d.drawImage(imgEl, -w / 2, -h / 2, w, h);
      } else {
        const fallbackGrad = ctx2d.createRadialGradient(0, 0, 20, 0, 0, w * 0.7);
        fallbackGrad.addColorStop(0, '#3b0712');
        fallbackGrad.addColorStop(1, '#050204');
        ctx2d.fillStyle = fallbackGrad;
        ctx2d.fillRect(-w / 2, -h / 2, w, h);
      }
      ctx2d.restore();

      // ==================== PER-DIALOGUE FOREGROUND SCENE ANIMATIONS ====================
      const ov = beat.beatOverlay;

      // 1. Rain & Windshield Wipers (Beat 1.1, 1.2, 1.4, 2.1, 2.3)
      if (ov === 'car_wipers_rain' || ov === 'gps_no_signal' || ov === 'red_bride_headlights' || ov === 'engine_smoke_haveli' || ov === 'lantern_swing' || ov === 'rain_lightning') {
        ctx2d.strokeStyle = 'rgba(186, 230, 253, 0.38)';
        ctx2d.lineWidth = 1.3;
        ctx2d.beginPath();
        rainDrops.forEach(d => {
          d.y += d.speed;
          d.x -= 0.003;
          if (d.y > 1) { d.y = -0.05; d.x = Math.random(); }
          if (d.x < 0) d.x = 1;
          const rx = d.x * w;
          const ry = d.y * h;
          ctx2d.moveTo(rx, ry);
          ctx2d.lineTo(rx - 6, ry + d.len);
        });
        ctx2d.stroke();
      }

      // Beat 1.2: Flickering "GPS: NO SIGNAL" HUD & Distant Red Glint
      if (ov === 'gps_no_signal') {
        if (Math.floor(frameTick / 18) % 2 === 0) {
          ctx2d.fillStyle = 'rgba(220, 38, 38, 0.85)';
          ctx2d.font = 'bold 13px monospace';
          ctx2d.fillText('⚠️ GPS SIGNAL LOST — KALI GHATI (02:00 AM)', w * 0.04, h * 0.24);
        }
      }

      // Beat 1.3: Intense Headlight Beams & Red Aura on Rukmini's Twisted Feet on the Road
      if (ov === 'red_bride_headlights') {
        const pulse = 0.35 + Math.sin(frameTick * 0.18) * 0.25;
        const feetGlow = ctx2d.createRadialGradient(w * 0.5, h * 0.72, 4, w * 0.5, h * 0.72, 95);
        feetGlow.addColorStop(0, `rgba(239, 68, 68, ${pulse})`);
        feetGlow.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx2d.fillStyle = feetGlow;
        ctx2d.beginPath();
        ctx2d.arc(w * 0.5, h * 0.72, 95, 0, Math.PI * 2);
        ctx2d.fill();
      }

      // Beat 1.4 & Beat 3.3: Rising Smoke Clouds (Car Engine Smoke / Blown-Out Diyas Smoke)
      if (ov === 'engine_smoke_haveli' || ov === 'smoking_blown_diyas') {
        smokePuffs.forEach(sp => {
          sp.y -= sp.vy;
          if (sp.y < 0.25) sp.y = 0.78;
          const sx = sp.x * w + Math.sin(frameTick * 0.03 + sp.y * 8) * 18;
          const sy = sp.y * h;
          const sGrad = ctx2d.createRadialGradient(sx, sy, 2, sx, sy, sp.r);
          sGrad.addColorStop(0, 'rgba(214, 211, 209, 0.22)');
          sGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          ctx2d.fillStyle = sGrad;
          ctx2d.beginPath();
          ctx2d.arc(sx, sy, sp.r, 0, Math.PI * 2);
          ctx2d.fill();
        });
      }

      // Beat 2.1, 2.2, 8.4, 9.2: Warm Flickering Lantern Glow of Old Watchman
      if (ov === 'lantern_swing' || ov === 'watchman_lantern_glow') {
        const lx = ov === 'watchman_lantern_glow' ? w * 0.34 : w * 0.68 + Math.sin(frameTick * 0.06) * 18;
        const ly = ov === 'watchman_lantern_glow' ? h * 0.62 : h * 0.68;
        const lr = ov === 'watchman_lantern_glow' ? 140 + Math.sin(frameTick * 0.2) * 16 : 95;
        const lGrad = ctx2d.createRadialGradient(lx, ly, 4, lx, ly, lr);
        lGrad.addColorStop(0, 'rgba(251, 191, 36, 0.55)');
        lGrad.addColorStop(0.5, 'rgba(217, 119, 6, 0.22)');
        lGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx2d.fillStyle = lGrad;
        ctx2d.beginPath();
        ctx2d.arc(lx, ly, lr, 0, Math.PI * 2);
        ctx2d.fill();
      }

      // Beat 3.2: Flying Black Crows Across Courtyard Arches
      if (ov === 'doli_flying_crows') {
        ctx2d.strokeStyle = 'rgba(10, 10, 12, 0.9)';
        ctx2d.lineWidth = 2.5;
        for (let c = 0; c < 6; c++) {
          const cx = ((frameTick * (1.4 + c * 0.25) + c * 140) % (w + 80)) - 40;
          const cy = h * (0.16 + c * 0.045) + Math.sin(frameTick * 0.08 + c) * 10;
          const wingY = Math.sin(frameTick * 0.28 + c) * 9;
          ctx2d.beginPath();
          ctx2d.moveTo(cx - 12, cy + wingY);
          ctx2d.quadraticCurveTo(cx - 4, cy - 6, cx, cy);
          ctx2d.quadraticCurveTo(cx + 4, cy - 6, cx + 12, cy + wingY);
          ctx2d.stroke();
        }
      }

      // Beat 4.1, 4.4, 6.1, 6.2, 6.4, 7.1, 7.2, 8.1, 9.3: Fire Embers / Well Red Vortex
      if (ov === 'fire_embers_rise' || ov === 'havan_flames_burst' || ov === 'bangles_shatter_sparks' || ov === 'payal_blood_glow' || ov === 'well_red_vortex') {
        fireEmbers.forEach(e => {
          e.y -= e.vy * (ov === 'havan_flames_burst' ? 1.65 : 1.0);
          e.x += e.vx + Math.sin(frameTick * 0.05 + e.y * 10) * 0.0015;
          if (e.y < 0.06) {
            e.y = 0.88;
            e.x = 0.25 + Math.random() * 0.5;
          }
          ctx2d.fillStyle = (ov === 'well_red_vortex' || ov === 'payal_blood_glow')
            ? `rgba(239, 68, 68, ${e.alpha})`
            : `rgba(251, 146, 60, ${e.alpha})`;
          ctx2d.beginPath();
          ctx2d.arc(e.x * w, e.y * h, e.r, 0, Math.PI * 2);
          ctx2d.fill();
        });
      }

      // Beat 5.3: Poisoned Saffron Milk Hypnotic Purple-Crimson Haze
      if (ov === 'poison_dizzy_wave') {
        const pAlpha = 0.22 + Math.sin(frameTick * 0.12) * 0.12;
        ctx2d.fillStyle = `rgba(136, 19, 55, ${pAlpha})`;
        ctx2d.fillRect(0, 0, w, h);
      }

      // Beat 7.3, 8.2, 8.3: Expanding Red Soundwave Sonar Rings & Glowing Eyes
      if (ov === 'sonar_eyes_pulse') {
        const cx = w * 0.5;
        const cy = h * 0.48;
        soundRings.forEach((offset) => {
          const prog = ((frameTick * 0.009) + offset) % 1;
          const radius = prog * (w * 0.44);
          const alpha = (1 - prog) * 0.6;
          ctx2d.strokeStyle = `rgba(239, 68, 68, ${alpha})`;
          ctx2d.lineWidth = 2.4;
          ctx2d.beginPath();
          ctx2d.arc(cx, cy, radius, 0, Math.PI * 2);
          ctx2d.stroke();
        });
      }

      // Beat 9.4: Spotlight Halos over the 4 Cursed Relics Around the Well
      if (ov === 'four_relics_spotlight') {
        const spots = [
          { x: 0.25, y: 0.73 },
          { x: 0.35, y: 0.51 },
          { x: 0.67, y: 0.51 },
          { x: 0.75, y: 0.73 }
        ];
        const activeSpotIdx = Math.floor(frameTick / 45) % spots.length;
        spots.forEach((s, idx) => {
          const isHighlighted = idx === activeSpotIdx;
          const r = isHighlighted ? 58 : 32;
          const grad = ctx2d.createRadialGradient(s.x * w, s.y * h, 2, s.x * w, s.y * h, r);
          grad.addColorStop(0, isHighlighted ? 'rgba(251, 191, 36, 0.75)' : 'rgba(220, 38, 38, 0.35)');
          grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          ctx2d.fillStyle = grad;
          ctx2d.beginPath();
          ctx2d.arc(s.x * w, s.y * h, r, 0, Math.PI * 2);
          ctx2d.fill();
        });
      }

      // Dark Horror Vignette
      const vigGrad = ctx2d.createRadialGradient(w / 2, h / 2, w * 0.26, w / 2, h / 2, w * 0.66);
      vigGrad.addColorStop(0, 'rgba(0, 0, 0, 0)');
      vigGrad.addColorStop(1, 'rgba(8, 0, 2, 0.76)');
      ctx2d.fillStyle = vigGrad;
      ctx2d.fillRect(0, 0, w, h);

      // Shot-Cut Film Transition Effect whenever a dialogue changes
      if (shotCutTransitionAlpha > 0.01) {
        ctx2d.fillStyle = `rgba(15, 3, 6, ${shotCutTransitionAlpha})`;
        ctx2d.fillRect(0, 0, w, h);
        shotCutTransitionAlpha *= 0.82;
      }

      // Lightning Flash Overlay
      if (lightningFlashAlpha > 0.01) {
        ctx2d.fillStyle = `rgba(224, 242, 254, ${lightningFlashAlpha * 0.55})`;
        ctx2d.fillRect(0, 0, w, h);
        lightningFlashAlpha *= 0.84;
      }

      // Full-Screen Jump Scare Climax Overlay (Beat 10.4 or Test Button)
      if (jumpScareFlashTimer > 0) {
        jumpScareFlashTimer--;
        const scareImg = document.getElementById('art-scene-5');
        if (scareImg && scareImg.complete && scareImg.naturalWidth > 0) {
          ctx2d.save();
          ctx2d.translate(w / 2 + (Math.random() - 0.5) * 34, h * 0.33 + (Math.random() - 0.5) * 34);
          ctx2d.scale(2.35, 2.35);
          ctx2d.drawImage(scareImg, -w / 2, -h / 2, w, h);
          ctx2d.restore();
        }
        ctx2d.fillStyle = 'rgba(185, 28, 28, 0.36)';
        ctx2d.fillRect(0, 0, w, h);
      }

      animFrameId = requestAnimationFrame(drawHorrorCutsceneFrame);
    }

