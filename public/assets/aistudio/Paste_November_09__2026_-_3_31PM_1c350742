<!DOCTYPE html>
<html lang="hi" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Rakt Pishachini: Rukmini Ka Shrap — 40-Shot Per-Dialogue Animated Story &amp; 4P Lobby</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
    }
    body {
      font-family: 'Noto Sans Devanagari', 'Inter', sans-serif;
      background-color: #070406;
      color: #f5e6e8;
      overflow-x: hidden;
      user-select: none;
    }
    .horror-glow {
      text-shadow: 0 0 18px rgba(220, 38, 38, 0.85), 0 0 36px rgba(153, 27, 27, 0.65);
    }
    .gold-glow {
      text-shadow: 0 0 14px rgba(245, 158, 11, 0.7);
    }
    .crimson-border {
      border-color: rgba(185, 28, 28, 0.55);
      box-shadow: 0 0 24px rgba(153, 27, 27, 0.28), inset 0 0 16px rgba(127, 29, 29, 0.18);
    }
    .subtitle-box {
      background: linear-gradient(180deg, rgba(10, 4, 7, 0.82) 0%, rgba(18, 5, 9, 0.96) 100%);
      backdrop-filter: blur(8px);
    }
    @keyframes pulseRed {
      0%, 100% { box-shadow: 0 0 15px rgba(220, 38, 38, 0.45); }
      50% { box-shadow: 0 0 32px rgba(239, 68, 68, 0.9); }
    }
    .pulse-red-btn {
      animation: pulseRed 2.2s infinite ease-in-out;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #12070a;
    }
    ::-webkit-scrollbar-thumb {
      background: #7f1d1d;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#070406] text-stone-100">

  <!-- Hidden preload images: 13 distinct AI horror keyframes so EVERY single dialogue beat changes the visual scene -->
  <div class="hidden" aria-hidden="true">
    <img id="art-scene-1" src="data:image/jpeg;base64," alt="Kali Ghati SUV and Thakur Haveli Gate" />
    <img id="art-scene-2" src="data:image/jpeg;base64," alt="1992 Cursed Wedding Doli in Thakur Haveli" />
    <img id="art-scene-3" src="data:image/jpeg;base64," alt="Underground Tehkhana and Tantrik Havan Kund" />
    <img id="art-scene-4" src="data:image/jpeg;base64," alt="Cursed Dry Well and 4 Relics" />
    <img id="art-scene-5" src="data:image/jpeg;base64," alt="Rakt Pishachini Ghostly Bride in Corridor" />
    <img id="art-friends-car" src="data:image/jpeg;base64," alt="Four Friends Inside SUV in Rainy Forest" />
    <img id="art-red-bride-road" src="data:image/jpeg;base64," alt="Ghost Bride in Red Saree Standing in Car Headlights on Road" />
    <img id="art-watchman-closeup" src="data:image/jpeg;base64," alt="Old Watchman Ramu Kaka Holding Lantern Close-up" />
    <img id="art-bride-rukmini-1992" src="data:image/jpeg;base64," alt="Young Bride Rukmini in Eerie Courtyard with Blowing Out Diyas" />
    <img id="art-poison-milk" src="data:image/jpeg;base64," alt="Husband Offering Poisoned Saffron Milk Glass to Bride Rukmini" />
    <img id="art-chains-ritual" src="data:image/jpeg;base64," alt="Iron Chains Broken Red Bangles and Silver Payal Beside Fire" />
    <img id="art-well-inside" src="data:image/jpeg;base64," alt="View From Bottom of Deep Cursed Well as Stone Slab Closes" />
    <img id="art-friends-trapped-hall" src="data:image/jpeg;base64," alt="Four Friends Trapped Inside Thakur Haveli Hall with Flashlights" />
  </div>

  <!-- Top Navigation & Mode Bar -->
  <header class="w-full bg-[#0e0609]/95 border-b border-red-950/80 px-3 sm:px-5 py-2.5 flex flex-wrap items-center justify-between gap-2 z-30">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-red-950/90 border border-red-700/60 text-red-400 font-bold text-lg">🩸</span>
      <div>
        <h1 class="text-sm sm:text-base font-extrabold tracking-wide text-red-500 horror-glow leading-tight">
          THE RAKT PISHACHINI: RUKMINI KA SHRAP
        </h1>
        <p class="text-[11px] text-stone-400">हर डायलॉग पर बदलने वाले 40 लाइव सीन शॉट्स • 10 डार्क चैप्टर्स</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
      <button id="tab-story-btn" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-700 text-white border border-red-500 transition">
        🎬 10-सीन एनिमेटेड स्टोरी
      </button>
      <button id="tab-lobby-btn" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-stone-900/90 text-stone-300 border border-stone-700 hover:border-red-700 transition">
        🎮 4-प्लेयर हवेली लॉबी
      </button>
      <button id="tab-prompt-btn" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-950/80 text-amber-300 border border-amber-700/70 hover:bg-amber-900/80 transition">
        📋 AI Studio प्रॉम्प्ट कॉपी करें
      </button>
      <button id="audio-toggle-btn" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-stone-900 text-emerald-400 border border-emerald-800/70 hover:bg-stone-800 transition" title="साउंड और हिंदी आवाज़ ऑन/ऑफ">
        🔊 आवाज़: ON
      </button>
    </div>
  </header>

  <!-- Main Workspace Container -->
  <main class="flex-1 w-full max-w-6xl mx-auto px-2 sm:px-4 py-2.5 flex flex-col gap-2.5">

    <!-- ==================== VIEW 1: 10-CHAPTER (40-SHOT PER-DIALOGUE) CUTSCENE ==================== -->
    <section id="view-story" class="flex flex-col gap-2.5">

      <!-- Chapter Selector Strip (Scenes 1 to 10) -->
      <div class="bg-[#11070b] border border-red-950/80 rounded-xl p-2 flex flex-col gap-1.5">
        <div class="flex flex-wrap items-center justify-between gap-1 px-1">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-red-400">
            10 डार्क चैप्टर्स • हर एक डायलॉग (40 शॉट्स) पर अलग विजुअल सीन
          </span>
          <div class="flex items-center gap-2">
            <span id="story-timer-badge" class="text-[11px] font-mono px-2 py-0.5 rounded bg-red-950/80 text-red-300 border border-red-800/50">
              सीन 1/10 • शॉट 1/40
            </span>
            <button id="pace-toggle-btn" type="button" class="text-[11px] px-2 py-0.5 rounded bg-stone-900 text-amber-300 border border-amber-800/60 hover:bg-stone-800 transition">
              ⏱️ रफ़्तार: सिनेमैटिक (Slow Horror)
            </button>
          </div>
        </div>
        <div id="chapter-pills-container" class="grid grid-cols-5 sm:grid-cols-10 gap-1">
          <!-- Populated dynamically by JS -->
        </div>
      </div>

      <!-- 16:9 Animated Horror Cutscene Viewport -->
      <div id="cutscene-stage-wrapper" class="relative w-full aspect-video max-h-[63vh] bg-black rounded-2xl overflow-hidden crimson-border border-2 flex items-center justify-center">
        <!-- Live HTML5 2.5D Horror Animation Canvas -->
        <canvas id="horror-canvas" class="w-full h-full block"></canvas>

        <!-- Top-Left Chapter & Per-Dialogue Live Shot Badge -->
        <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-10 pointer-events-none flex flex-col gap-1 max-w-[68%]">
          <div class="flex flex-wrap items-center gap-1.5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-black/85 border border-red-800/70 backdrop-blur-sm">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
              <span id="hud-chapter-time" class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-red-400">00:00 - 01:00 • सीन 1</span>
            </div>
            <span id="hud-shot-badge" class="px-2.5 py-0.5 rounded-full bg-amber-950/90 border border-amber-600/70 text-amber-300 text-[10px] sm:text-[11px] font-bold backdrop-blur-sm">
              🎥 शॉट 1/40: कार के अंदर डरे हुए चारों दोस्त
            </span>
          </div>
          <h2 id="hud-chapter-title" class="text-sm sm:text-lg md:text-xl font-extrabold text-white horror-glow drop-shadow-md leading-snug">
            सीन 1: काली घाटी और भटकती कार
          </h2>
        </div>

        <!-- Top-Right "Skip Story ⏭️" Button -->
        <div class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 flex items-center gap-1.5">
          <button id="trigger-jumpscare-btn" type="button" class="px-2.5 py-1.5 rounded-lg bg-red-950/85 hover:bg-red-800 text-red-200 border border-red-700/70 text-xs font-semibold backdrop-blur-sm transition">
            👻 Jump Scare टेस्ट
          </button>
          <button id="skip-story-btn" type="button" class="px-3 py-1.5 rounded-lg bg-black/85 hover:bg-red-700 text-white border border-red-500/80 text-xs sm:text-sm font-bold backdrop-blur-sm transition flex items-center gap-1 shadow-lg">
            <span>Skip Story</span>
            <span>⏭️</span>
          </button>
        </div>

        <!-- Start Overlay (Unlocks Browser Web Audio & Hindi Voice Narration) -->
        <div id="start-cutscene-overlay" class="absolute inset-0 z-25 bg-black/80 backdrop-blur-sm flex flex-col items-center justify-center p-4 text-center">
          <div class="max-w-lg bg-[#12060a]/95 border border-red-700/80 rounded-2xl p-5 sm:p-6 shadow-2xl flex flex-col items-center gap-3">
            <span class="px-3 py-1 rounded-full bg-amber-950 text-amber-300 border border-amber-700 text-xs font-bold">
              ✨ अपग्रेडेड: हर एक डायलॉग पर नया सीन और शॉट (40 Dynamic Shots)
            </span>
            <h3 class="text-xl sm:text-2xl font-extrabold text-red-500 horror-glow">
              द रक्त-पिशाचिनी: रुक्मिणी का श्राप
            </h3>
            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
              अब एक ही फोटो अटक कर नहीं रहेगी! **जो किरदार जैसा डायलॉग बोलेगा, स्क्रीन पर तुरंत वैसा ही सीन आएगा**—कार के अंदर 4 दोस्त, सड़क पर लाल साड़ी में खड़ी रुक्मिणी, लालटेन लिए बूढ़ा चौकीदार, सूने आंगन में बुझते दीये, नशीला दूध का गिलास, जंजीरें-हवन कुंड और कुएं के अंदर का मंजर!
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2.5 mt-1">
              <button id="start-movie-btn" type="button" class="px-5 py-2.5 rounded-xl bg-red-700 hover:bg-red-600 text-white font-bold text-sm sm:text-base pulse-red-btn transition flex items-center gap-2">
                <span>▶️ 10-मिनट की एनिमेटेड स्टोरी शुरू करें</span>
              </button>
              <button id="overlay-skip-to-lobby-btn" type="button" class="px-4 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-stone-200 border border-stone-700 text-xs sm:text-sm font-semibold transition">
                Skip Story ⏭️ (सीधे लॉबी में जाएं)
              </button>
            </div>
          </div>
        </div>

        <!-- Bottom Cinematic Hindi Subtitle & 4-Beat Mini Selector Bar -->
        <div class="absolute bottom-0 inset-x-0 z-15 p-2.5 sm:p-3.5 subtitle-box border-t border-red-900/60">
          <div class="max-w-4xl mx-auto flex flex-col gap-1.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-2">
                <span id="speaker-badge" class="px-2.5 py-0.5 rounded-md bg-red-800 text-white text-xs font-bold tracking-wide">
                  🎙️ सूत्रधार (Narrator)
                </span>
                <span id="sfx-indicator" class="text-[11px] text-amber-300/95 font-medium">
                  🔊 [मूसलाधार बारिश और कार के अंदर घबराहट]
                </span>
              </div>

              <!-- Clickable 4-Dialogue Shot Pills for Current Scene -->
              <div class="flex items-center gap-2"><span id="beat-counter-label" class="text-[11px] text-stone-400 font-mono">संवाद 1 / 4</span><div id="scene-beat-dots" class="flex items-center gap-1">
                <!-- Populated by JS so user can also click Beat 1, 2, 3, 4 directly -->
              </div></div>
            </div>

            <p id="subtitle-hindi-text" class="text-sm sm:text-base md:text-lg font-semibold text-stone-100 leading-snug min-h-[2.5rem]">
              रात के ठीक दो बज रहे हैं। काली घाटी के सुनसान जंगल में मूसलाधार बारिश हो रही है और आरव, कबीर, रिया और देव कार के अंदर घबराए हुए हैं...
            </p>

            <!-- Progress bar for current beat -->
            <div class="w-full h-1.5 bg-stone-900 rounded-full overflow-hidden mt-0.5">
              <div id="beat-progress-bar" class="h-full bg-gradient-to-r from-red-700 via-red-500 to-amber-500 transition-all duration-150" style="width: 0%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Cutscene Playback & Sound Effect Controls -->
      <div class="bg-[#11070b] border border-red-950/90 rounded-xl p-2.5 flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          <button id="prev-scene-btn" type="button" class="px-2.5 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-stone-200 border border-stone-700 text-xs font-semibold transition">
            ⏮️ पिछला सीन
          </button>
          <button id="prev-beat-btn" type="button" class="px-2.5 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-amber-300 border border-amber-800/70 text-xs font-semibold transition">
            ⏪ पिछला डायलॉग शॉट
          </button>
          <button id="play-pause-btn" type="button" class="px-4 py-1.5 rounded-lg bg-red-700 hover:bg-red-600 text-white text-xs sm:text-sm font-bold transition">
            ⏸️ रोकें (Pause)
          </button>
          <button id="next-beat-btn" type="button" class="px-3 py-1.5 rounded-lg bg-amber-950/90 hover:bg-amber-900 text-amber-200 border border-amber-600/80 text-xs font-bold transition">
            अगला संवाद ⏩
          </button>
          <button id="next-scene-btn" type="button" class="px-2.5 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-stone-200 border border-stone-700 text-xs font-semibold transition">
            अगला सीन ⏭️
          </button>
        </div>

        <!-- Instant Horror Sound Triggers -->
        <div class="flex flex-wrap items-center gap-1.5">
          <button id="sfx-payal-btn" type="button" class="px-2.5 py-1 rounded-md bg-stone-900 hover:bg-red-950 text-amber-300 border border-stone-700 text-xs transition">
            🔔 पायल की छन-छन
          </button>
          <button id="sfx-thunder-btn" type="button" class="px-2.5 py-1 rounded-md bg-stone-900 hover:bg-red-950 text-sky-300 border border-stone-700 text-xs transition">
            ⚡ बिजली कड़कना
          </button>
          <button id="sfx-gate-btn" type="button" class="px-2.5 py-1 rounded-md bg-stone-900 hover:bg-red-950 text-stone-300 border border-stone-700 text-xs transition">
            🚪 लोहे का गेट बंद
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== VIEW 2: 4-PLAYER THAKUR HAVELI LOBBY & 3D PREVIEW ==================== -->
    <section id="view-lobby" class="hidden flex-col gap-3">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-3">

        <!-- Left 2 Columns: 4-Player Co-op Selection & Cursed Relics Tracker -->
        <div class="lg:col-span-2 bg-[#11070b] border border-red-950/90 rounded-2xl p-4 flex flex-col gap-4">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-red-950/80 pb-3">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-red-400">ठाकुर हवेली • मल्टीप्लेयर सर्वाइवल लॉबी</span>
              <h2 class="text-lg sm:text-xl font-extrabold text-white horror-glow">
                4 दोस्त — अपना सर्वाइवर चुनें (1–4 Players)
              </h2>
            </div>
            <button id="back-to-story-btn" type="button" class="px-3 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-stone-300 border border-stone-700 text-xs font-semibold transition">
              🎬 वापस स्टोरी कट-सीन देखें
            </button>
          </div>

          <!-- 4 Friends Cards -->
          <div id="player-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <!-- Populated by JS -->
          </div>

          <!-- The 4 Cursed Relics of Rukmini (Interactive Inspection) -->
          <div class="bg-[#0a0407] border border-red-900/50 rounded-xl p-3.5 flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-xs sm:text-sm font-bold text-amber-400">
                🔥 मुक्ति का मिशन: हवेली के 4 कमरों से रुक्मिणी की 4 शापित चीज़ें ढूंढकर सूखे कुएं में जलाएं
              </h3>
              <span id="relic-collected-count" class="text-xs font-mono px-2 py-0.5 rounded bg-red-950 text-red-300 border border-red-800/60">
                0 / 4 मिलीं
              </span>
            </div>
            <p class="text-xs text-stone-400">
              नीचे किसी भी शापित चीज़ पर क्लिक करके देखें कि वह किस कमरे में छिपी है और उसे जलाने पर रुक्मिणी कैसे भड़कती है:
            </p>
            <div id="relics-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <!-- Populated by JS -->
            </div>
          </div>
        </div>

        <!-- Right Column: Sound-Hunting AI Radar (Aahat Meter) & Enter Haveli -->
        <div class="bg-[#11070b] border border-red-950/90 rounded-2xl p-4 flex flex-col justify-between gap-4">
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-red-400">रुक्मिणी का साउंड AI</span>
              <span class="px-2 py-0.5 rounded bg-red-950 text-red-300 text-[11px] font-semibold border border-red-800/60">
                अंधी पर हर आहट सुनती है
              </span>
            </div>
            <h3 class="text-base font-extrabold text-white">
              आहट मीटर (Sound Decibel Radar)
            </h3>
            <p class="text-xs text-stone-300 leading-relaxed">
              तहखाने में पैर उल्टे मोड़े जाने और कुएं में फेंके जाने के बाद रुक्मिणी देख नहीं सकती—लेकिन अगर आप तेज़ दौड़ेंगे या माइक में बोलेंगे, तो उसकी पायल की छन-छन आपके पास आ जाएगी!
            </p>

            <!-- Interactive Sound Simulation Meter -->
            <div class="bg-black/80 border border-red-900/60 rounded-xl p-3 flex flex-col gap-2.5">
              <div class="flex items-center justify-between text-xs">
                <span class="text-stone-400">आपकी आहट (Noise Level):</span>
                <span id="noise-status-label" class="font-bold text-emerald-400">शांत (12 dB) — सुरक्षित</span>
              </div>
              <div class="w-full h-3 bg-stone-900 rounded-full overflow-hidden border border-stone-800">
                <div id="noise-meter-bar" class="h-full bg-emerald-500 transition-all duration-200" style="width: 12%;"></div>
              </div>
              <div class="flex items-center justify-between text-xs pt-1">
                <span class="text-stone-400">रुक्मिणी की दूरी:</span>
                <span id="rukmini-distance-label" class="font-mono font-bold text-amber-300">28 मीटर दूर (गलियारा)</span>
              </div>
              <div class="grid grid-cols-3 gap-1.5 pt-1">
                <button id="sim-walk-btn" type="button" class="px-2 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-emerald-300 border border-stone-700 text-[11px] font-semibold transition">
                  🤫 दबे पाँव चलें
                </button>
                <button id="sim-run-btn" type="button" class="px-2 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-amber-300 border border-stone-700 text-[11px] font-semibold transition">
                  🏃 तेज़ दौड़ें
                </button>
                <button id="sim-scream-btn" type="button" class="px-2 py-1.5 rounded-lg bg-red-950 hover:bg-red-900 text-red-200 border border-red-800 text-[11px] font-semibold transition">
                  📢 शोर मचाएं!
                </button>
              </div>
            </div>
