  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
    }
    body {
      font-family: 'Noto Sans Devanagari', 'Inter', sans-serif;
      background-color: #070406;
      color: #f5e6e8;
      overflow-x: hidden;
      user-select: none;
    }
    .horror-glow {
      text-shadow: 0 0 18px rgba(220, 38, 38, 0.85), 0 0 36px rgba(153, 27, 27, 0.65);
    }
    .gold-glow {
      text-shadow: 0 0 14px rgba(245, 158, 11, 0.7);
    }
    .crimson-border {
      border-color: rgba(185, 28, 28, 0.55);
      box-shadow: 0 0 24px rgba(153, 27, 27, 0.28), inset 0 0 16px rgba(127, 29, 29, 0.18);
    }
    .subtitle-box {
      background: linear-gradient(180deg, rgba(10, 4, 7, 0.78) 0%, rgba(18, 5, 9, 0.94) 100%);
      backdrop-filter: blur(8px);
