            <div class="flex items-center justify-between">
              <h3 class="text-xs sm:text-sm font-bold text-amber-400">
                🔥 मुक्ति का मिशन: हवेली के 4 कमरों से रुक्मिणी की 4 शापित चीज़ें ढूंढकर सूखे कुएं में जलाएं
              </h3>
              <span id="relic-collected-count" class="text-xs font-mono px-2 py-0.5 rounded bg-red-950 text-red-300 border border-red-800/60">
                0 / 4 मिलीं
              </span>
            </div>
            <p class="text-xs text-stone-400">
              नीचे किसी भी शापित चीज़ पर क्लिक करके देखें कि वह किस कमरे में छिपी है और उसे जलाने पर रुक्मिणी कैसे भड़कती है:
            </p>
            <div id="relics-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <!-- Populated by JS -->
            </div>
          </div>
        </div>

        <!-- Right Column: Sound-Hunting AI Radar (Aahat Meter) & Enter Haveli -->
        <div class="bg-[#11070b] border border-red-950/90 rounded-2xl p-4 flex flex-col justify-between gap-4">
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-red-400">रुक्मिणी का साउंड AI</span>
              <span class="px-2 py-0.5 rounded bg-red-950 text-red-300 text-[11px] font-semibold border border-red-800/60">
                अंधी पर हर आहट सुनती है
              </span>
            </div>
            <h3 class="text-base font-extrabold text-white">
              आहट मीटर (Sound Decibel Radar)
            </h3>
            <p class="text-xs text-stone-300 leading-relaxed">
              तहखाने में पैर उल्टे मोड़े जाने और कुएं में फेंके जाने के बाद रुक्मिणी देख नहीं सकती—लेकिन अगर आप तेज़ दौड़ेंगे या माइक में बोलेंगे, तो उसकी पायल की छन-छन आपके पास आ जाएगी!
            </p>

            <!-- Interactive Sound Simulation Meter -->
            <div class="bg-black/80 border border-red-900/60 rounded-xl p-3 flex flex-col gap-2.5">
              <div class="flex items-center justify-between text-xs">
                <span class="text-stone-400">आपकी आहट (Noise Level):</span>
                <span id="noise-status-label" class="font-bold text-emerald-400">शांत (12 dB) — सुरक्षित</span>
              </div>
              <div class="w-full h-3 bg-stone-900 rounded-full overflow-hidden border border-stone-800">
                <div id="noise-meter-bar" class="h-full bg-emerald-500 transition-all duration-200" style="width: 12%;"></div>
              </div>
              <div class="flex items-center justify-between text-xs pt-1">
                <span class="text-stone-400">रुक्मिणी की दूरी:</span>
                <span id="rukmini-distance-label" class="font-mono font-bold text-amber-300">28 मीटर दूर (गलियारा)</span>
              </div>
              <div class="grid grid-cols-3 gap-1.5 pt-1">
                <button id="sim-walk-btn" type="button" class="px-2 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-emerald-300 border border-stone-700 text-[11px] font-semibold transition">
                  🤫 दबे पाँव चलें
                </button>
                <button id="sim-run-btn" type="button" class="px-2 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-amber-300 border border-stone-700 text-[11px] font-semibold transition">
                  🏃 तेज़ दौड़ें
                </button>
                <button id="sim-scream-btn" type="button" class="px-2 py-1.5 rounded-lg bg-red-950 hover:bg-red-900 text-red-200 border border-red-800 text-[11px] font-semibold transition">
