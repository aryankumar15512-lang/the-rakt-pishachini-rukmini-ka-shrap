          </button>
          <button id="skip-story-btn" type="button" class="px-3.5 py-1.5 rounded-lg bg-black/85 hover:bg-red-700 text-white border border-red-500/80 text-xs sm:text-sm font-bold backdrop-blur-sm transition flex items-center gap-1.5 shadow-lg">
            <span>Skip Story</span>
            <span>⏭️</span>
          </button>
        </div>

        <!-- Start Overlay (Ensures Browser Unlocks Web Audio & Hindi TTS on First Click) -->
        <div id="start-cutscene-overlay" class="absolute inset-0 z-25 bg-black/80 backdrop-blur-sm flex flex-col items-center justify-center p-4 text-center">
