    <!-- ==================== VIEW 2: 4-PLAYER THAKUR HAVELI LOBBY & 3D PREVIEW ==================== -->
    <section id="view-lobby" class="hidden flex-col gap-3">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-3">

        <!-- Left 2 Columns: 4-Player Co-op Selection & Cursed Relics Tracker -->
        <div class="lg:col-span-2 bg-[#11070b] border border-red-950/90 rounded-2xl p-4 flex flex-col gap-4">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-red-950/80 pb-3">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-red-400">ठाकुर हवेली • मल्टीप्लेयर सर्वाइवल लॉबी</span>
              <h2 class="text-lg sm:text-xl font-extrabold text-white horror-glow">
                4 दोस्त — अपना सर्वाइवर चुनें (1–4 Players)
              </h2>
            </div>
            <button id="back-to-story-btn" type="button" class="px-3 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-stone-300 border border-stone-700 text-xs font-semibold transition">
              🎬 वापस स्टोरी कट-सीन देखें
            </button>
          </div>

          <!-- 4 Friends Cards -->
          <div id="player-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
