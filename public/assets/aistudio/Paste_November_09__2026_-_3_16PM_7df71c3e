      <button id="audio-toggle-btn" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-stone-900 text-emerald-400 border border-emerald-800/70 hover:bg-stone-800 transition" title="साउंड और हिंदी आवाज़ ऑन/ऑफ">
