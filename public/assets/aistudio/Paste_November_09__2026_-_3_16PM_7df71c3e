        desc: 'हवन कुंड के पास टूटी हुई लाल चूड़ियाँ।'
      },
      {
        id: 'mirror',
        name: '4. टूटा श्रृंगार आईना',
        room: 'अंधेरी अटारी (Haunted Attic)',
        icon: '🪞',
        desc: 'वह आईना जिसमें रुक्मिणी ने आखिरी बार अपना चेहरा देखा था।'
      }
    ];

    // ==================== STATE ====================
    let activeView = 'story'; // 'story' | 'lobby' | 'prompt'
    let currentChapterIndex = 0;
    let currentBeatIndex = 0;
    let isPlaying = false;
    let hasStartedOnce = false;
    let audioEnabled = true;
    let slowHorrorPace = true; // true = ~12s per beat (10-min feel), false = ~5.5s per beat
    let beatElapsedMs = 0;
    let beatDurationMs = 11500;
    let beatIntervalId = null;
    let ttsKeepAliveId = null;
    let jumpScareFlashTimer = 0;
    let lightningFlashAlpha = 0;

    let selectedPlayerId = 'aarav';
    let collectedRelics = {};
    let currentNoiseDb = 12;

    // ==================== WEB AUDIO HORROR SYNTHESIZER ====================
    let audioCtx = null;
    let rainGainNode = null;
    let droneOsc = null;
    let droneGain = null;

    function ensureAudioContext() {
      if (!audioEnabled) return null;
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
          startAmbientHorrorBed();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      return audioCtx;
    }

    function startAmbientHorrorBed() {
      if (!audioCtx) return;
      try {
        // Low ominous horror drone
        droneOsc = audioCtx.createOscillator();
        const droneSub = audioCtx.createOscillator();
        droneGain = audioCtx.createGain();
        droneOsc.type = 'sawtooth';
        droneSub.type = 'sine';
        droneOsc.frequency.value = 55; // A1 eerie low tone
        droneSub.frequency.value = 27.5;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 140;

        droneGain.gain.value = audioEnabled ? 0.05 : 0;
        droneOsc.connect(filter);
        droneSub.connect(filter);
        filter.connect(droneGain);
        droneGain.connect(audioCtx.destination);
        droneOsc.start();
        droneSub.start();

        // Synthesized continuous rain noise
        const bufferSize = audioCtx.sampleRate * 2;
        const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = Math.random() * 2 - 1;
        }
        const whiteNoise = audioCtx.createBufferSource();
        whiteNoise.buffer = noiseBuffer;
        whiteNoise.loop = true;

        const rainFilter = audioCtx.createBiquadFilter();
        rainFilter.type = 'bandpass';
        rainFilter.frequency.value = 950;
        rainFilter.Q.value = 0.7;

        rainGainNode = audioCtx.createGain();
        rainGainNode.gain.value = audioEnabled ? 0.035 : 0;

        whiteNoise.connect(rainFilter);
        rainFilter.connect(rainGainNode);
        rainGainNode.connect(audioCtx.destination);
        whiteNoise.start();
      } catch (e) {
        // Ignore audio setup errors on restricted browsers
      }
    }

    function playPayalChime() {
      const ctx = ensureAudioContext();
      if (!ctx || !audioEnabled) return;
      const now = ctx.currentTime;
      const freqs = [3100, 3850, 4420, 5100];
      freqs.forEach((f, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f + (idx * 90), now + idx * 0.06);
        gain.gain.setValueAtTime(0.08, now + idx * 0.06);
        gain.gain.exponentialRampToValueAtTime(0.0008, now + idx * 0.06 + 0.38);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now + idx * 0.06);
        osc.stop(now + idx * 0.06 + 0.4);
      });
    }

    function playThunderCrash() {
      lightningFlashAlpha = 0.95;
      const ctx = ensureAudioContext();
      if (!ctx || !audioEnabled) return;
      const now = ctx.currentTime;
      const bufferSize = ctx.sampleRate * 1.4;
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ctx.sampleRate * 0.45));
      }
      const noise = ctx.createBufferSource();
      noise.buffer = buffer;
      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(320, now);
      const gain = ctx.createGain();
      gain.gain.setValueAtTime(0.32, now);
      gain.gain.exponentialRampToValueAtTime(0.005, now + 1.35);
      noise.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      noise.start(now);
    }

    function playIronGateSlam() {
      const ctx = ensureAudioContext();
      if (!ctx || !audioEnabled) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(135, now);
      osc.frequency.exponentialRampToValueAtTime(28, now + 0.55);
      gain.gain.setValueAtTime(0.4, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.62);
    }

    function playJumpScareScream() {
      jumpScareFlashTimer = 42; // frames of intense jump scare overlay
      lightningFlashAlpha = 1.0;
      const ctx = ensureAudioContext();
      if (!ctx || !audioEnabled) return;
      const now = ctx.currentTime;
      [420, 580, 890, 1240].forEach((freq) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(freq, now);
        osc.frequency.linearRampToValueAtTime(freq * 1.45, now + 0.25);
        osc.frequency.exponentialRampToValueAtTime(freq * 0.6, now + 0.95);
        gain.gain.setValueAtTime(0.14, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.98);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 1.0);
      });
      playPayalChime();
    }

    // ==================== NON-STOP HINDI VOICE NARRATION (WITH CHROME KEEP-ALIVE) ====================
    function speakHindiBeat(text, speakerLabel) {
      if (!audioEnabled || !('speechSynthesis' in window)) return;
      try {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = 'hi-IN';

        const voices = window.speechSynthesis.getVoices();
        const hindiVoice = voices.find(v => v.lang && v.lang.toLowerCase().includes('hi')) ||
                           voices.find(v => v.name && v.name.toLowerCase().includes('hindi'));
        if (hindiVoice) {
          utter.voice = hindiVoice;
        }

        // Dramatic pitch/rate per character
        if (speakerLabel.includes('तांत्रिक') || speakerLabel.includes('ठाकुर')) {
          utter.pitch = 0.72;
          utter.rate = 0.88;
        } else if (speakerLabel.includes('चौकीदार')) {
          utter.pitch = 0.82;
          utter.rate = 0.86;
        } else if (speakerLabel.includes('रुक्मिणी') || speakerLabel.includes('पिशाचिनी')) {
          utter.pitch = 1.18;
          utter.rate = 0.88;
        } else {
          utter.pitch = 0.92;
          utter.rate = 0.92;
        }

        window.speechSynthesis.speak(utter);

        // Chrome TTS Keep-Alive so long narration never freezes mid-story
        if (ttsKeepAliveId) clearInterval(ttsKeepAliveId);
        ttsKeepAliveId = setInterval(() => {
          if (window.speechSynthesis && window.speechSynthesis.speaking && !window.speechSynthesis.paused) {
            window.speechSynthesis.pause();
            window.speechSynthesis.resume();
          }
        }, 4500);
      } catch (e) {
        // Fallback relies on beatIntervalId watchdog timer
      }
    }

    // ==================== STORY ENGINE & WATCHDOG AUTO-ADVANCE ====================
    function renderChapterPills() {
      const container = document.getElementById('chapter-pills-container');
      container.innerHTML = '';
      CHAPTERS.forEach((ch, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isActive = idx === currentChapterIndex;
        btn.className = isActive
          ? 'px-1.5 py-1.5 rounded-lg text-[11px] font-bold bg-red-700 text-white border border-red-400 shadow transition truncate'
          : 'px-1.5 py-1.5 rounded-lg text-[11px] font-medium bg-stone-900/90 text-stone-300 border border-stone-800 hover:border-red-800 transition truncate';
        btn.textContent = ch.shortTitle;
        btn.addEventListener('click', () => {
          jumpToChapter(idx);
        });
        container.appendChild(btn);
      });
    }

    function loadCurrentBeat(triggerVoice = true) {
      const chapter = CHAPTERS[currentChapterIndex];
      const beat = chapter.beats[currentBeatIndex];

      document.getElementById('hud-chapter-time').textContent = `${chapter.timeRange} • अध्याय ${chapter.id}/10`;
      document.getElementById('hud-chapter-title').textContent = chapter.title;
      document.getElementById('story-timer-badge').textContent = `सीन ${chapter.id}/10 • संवाद ${currentBeatIndex + 1}/${chapter.beats.length}`;
      document.getElementById('speaker-badge').textContent = beat.speaker;
      document.getElementById('sfx-indicator').textContent = beat.sfx;
      document.getElementById('beat-counter-label').textContent = `संवाद ${currentBeatIndex + 1} / ${chapter.beats.length}`;
      document.getElementById('subtitle-hindi-text').textContent = beat.text;
      document.getElementById('beat-progress-bar').style.width = '0%';

      renderChapterPills();

      // Calculate beat duration based on text length and pace mode so it never cuts off
      const charCount = beat.text.length;
      beatDurationMs = slowHorrorPace
        ? Math.max(9500, charCount * 92)
        : Math.max(5200, charCount * 52);
      beatElapsedMs = 0;

      // Trigger atmospheric SFX per scene
      if (triggerVoice && isPlaying) {
        if (chapter.id === 1 || chapter.id === 6) playThunderCrash();
        if (chapter.id === 3 || chapter.id === 8) playPayalChime();
        if (chapter.id === 10 && currentBeatIndex === 1) playIronGateSlam();
        if (chapter.id === 10 && currentBeatIndex === 3) playJumpScareScream();
        speakHindiBeat(beat.text, beat.speaker);
      }
    }

    function startBeatLoop() {
      if (beatIntervalId) clearInterval(beatIntervalId);
      beatIntervalId = setInterval(() => {
        if (!isPlaying) return;
        beatElapsedMs += 100;
        const pct = Math.min(100, (beatElapsedMs / beatDurationMs) * 100);
        const bar = document.getElementById('beat-progress-bar');
        if (bar) bar.style.width = `${pct}%`;

        // If speech finished early and at least 75% of beat duration elapsed, or full watchdog time reached -> advance!
        const speechDone = !('speechSynthesis' in window) || !window.speechSynthesis.speaking;
        if (beatElapsedMs >= beatDurationMs || (speechDone && beatElapsedMs >= beatDurationMs * 0.72)) {
          advanceToNextBeat();
        }
      }, 100);
    }

    function advanceToNextBeat() {
      const chapter = CHAPTERS[currentChapterIndex];
      if (currentBeatIndex < chapter.beats.length - 1) {
        currentBeatIndex++;
        loadCurrentBeat(true);
      } else if (currentChapterIndex < CHAPTERS.length - 1) {
        currentChapterIndex++;
        currentBeatIndex = 0;
        loadCurrentBeat(true);
      } else {
        // Finished all 10 chapters -> trigger final jump scare & transition to 4-Player Lobby!
        playJumpScareScream();
        isPlaying = false;
        updatePlayPauseButton();
        showToast('🎬 10 सीन की स्टोरी पूरी हुई! अब 4-प्लेयर ठाकुर हवेली लॉबी खुल रही है...');
        setTimeout(() => {
          switchView('lobby');
        }, 1600);
      }
    }

    function jumpToChapter(chapterIdx) {
      currentChapterIndex = Math.max(0, Math.min(CHAPTERS.length - 1, chapterIdx));
      currentBeatIndex = 0;
      if (!hasStartedOnce) {
        hasStartedOnce = true;
        document.getElementById('start-cutscene-overlay').classList.add('hidden');
      }
      isPlaying = true;
      ensureAudioContext();
      updatePlayPauseButton();
      loadCurrentBeat(true);
      startBeatLoop();
    }

    function updatePlayPauseButton() {
      const btn = document.getElementById('play-pause-btn');
      if (isPlaying) {
        btn.innerHTML = '⏸️ रोकें (Pause)';
        btn.className = 'px-4 py-1.5 rounded-lg bg-red-700 hover:bg-red-600 text-white text-xs sm:text-sm font-bold transition';
      } else {
        btn.innerHTML = '▶️ चलाएं (Play)';
        btn.className = 'px-4 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white text-xs sm:text-sm font-bold transition';
      }
    }

    // ==================== 2.5D CINEMATIC HORROR ANIMATION CANVAS ENGINE ====================
    const canvas = document.getElementById('horror-canvas');
    const ctx2d = canvas.getContext('2d');
    let animFrameId = null;
    let frameTick = 0;

    // Particle pools for rain, embers, crows, and soundwaves
    const rainDrops = Array.from({ length: 110 }, () => ({
      x: Math.random(),
      y: Math.random(),
      len: 12 + Math.random() * 18,
      speed: 0.018 + Math.random() * 0.015
    }));

    const fireEmbers = Array.from({ length: 65 }, () => ({
      x: 0.25 + Math.random() * 0.5,
      y: 0.5 + Math.random() * 0.5,
      r: 1.5 + Math.random() * 3.2,
      vy: 0.003 + Math.random() * 0.006,
      vx: (Math.random() - 0.5) * 0.003,
      alpha: 0.4 + Math.random() * 0.6
    }));

    const soundRings = [0, 0.33, 0.66];

    function resizeCanvas() {
      const wrapper = document.getElementById('cutscene-stage-wrapper');
      if (!wrapper) return;
      const rect = wrapper.getBoundingClientRect();
      canvas.width = Math.max(640, Math.floor(rect.width));
      canvas.height = Math.max(360, Math.floor(rect.height));
    }

    function drawHorrorCutsceneFrame() {
      frameTick++;
      const w = canvas.width;
      const h = canvas.height;
      const chapter = CHAPTERS[currentChapterIndex];
      const imgEl = document.getElementById(chapter.artId);

      ctx2d.clearRect(0, 0, w, h);

      // 1. Draw AI Keyframe with Smooth Ken Burns 2.5D Camera Pan & Zoom
      const zoom = 1.04 + Math.sin(frameTick * 0.008) * 0.035;
      const panX = Math.cos(frameTick * 0.006) * (w * 0.018);
      const panY = Math.sin(frameTick * 0.005) * (h * 0.014);

      // Camera shake on climax or jump scare
      const shakeX = jumpScareFlashTimer > 0 ? (Math.random() - 0.5) * 26 : 0;
      const shakeY = jumpScareFlashTimer > 0 ? (Math.random() - 0.5) * 26 : 0;

      ctx2d.save();
      ctx2d.translate(w / 2 + panX + shakeX, h / 2 + panY + shakeY);
      ctx2d.scale(zoom, zoom);
      if (imgEl && imgEl.complete && imgEl.naturalWidth > 0) {
        ctx2d.drawImage(imgEl, -w / 2, -h / 2, w, h);
      } else {
        const fallbackGrad = ctx2d.createRadialGradient(0, 0, 20, 0, 0, w * 0.7);
        fallbackGrad.addColorStop(0, '#3b0712');
        fallbackGrad.addColorStop(1, '#050204');
        ctx2d.fillStyle = fallbackGrad;
        ctx2d.fillRect(-w / 2, -h / 2, w, h);
      }
      ctx2d.restore();

      // 2. Scene-Specific Procedural Character & Horror Overlays
      const effect = chapter.effectType;

      // Rain & Car Headlight / Red Bride Silhouette (Scene 1 & 2)
      if (effect === 'rain_car' || effect === 'lantern_gate' || effect === 'climax_jumpscare') {
        ctx2d.strokeStyle = 'rgba(186, 230, 253, 0.35)';
        ctx2d.lineWidth = 1.3;
        ctx2d.beginPath();
        rainDrops.forEach(d => {
          d.y += d.speed;
          d.x -= 0.003;
          if (d.y > 1) { d.y = -0.05; d.x = Math.random(); }
          if (d.x < 0) d.x = 1;
          const rx = d.x * w;
          const ry = d.y * h;
          ctx2d.moveTo(rx, ry);
          ctx2d.lineTo(rx - 6, ry + d.len);
        });
        ctx2d.stroke();
      }

      // Scene 1: Fleeting Red Bride Silhouette in Headlights
      if (effect === 'rain_car') {
        const brideAlpha = 0.25 + Math.max(0, Math.sin(frameTick * 0.045)) * 0.55;
        const bx = w * 0.54 + Math.sin(frameTick * 0.02) * 8;
        const by = h * 0.54;
        const glow = ctx2d.createRadialGradient(bx, by, 4, bx, by, 68);
        glow.addColorStop(0, `rgba(220, 38, 38, ${brideAlpha})`);
        glow.addColorStop(1, 'rgba(220, 38, 38, 0)');
        ctx2d.fillStyle = glow;
        ctx2d.beginPath();
        ctx2d.arc(bx, by, 68, 0, Math.PI * 2);
        ctx2d.fill();
      }

      // Scene 2: Swinging Warm Lantern of Watchman Ramu Kaka
      if (effect === 'lantern_gate') {
        const swingX = w * 0.68 + Math.sin(frameTick * 0.06) * 22;
        const swingY = h * 0.68 + Math.cos(frameTick * 0.12) * 5;
        const lGrad = ctx2d.createRadialGradient(swingX, swingY, 3, swingX, swingY, 95);
        lGrad.addColorStop(0, 'rgba(251, 191, 36, 0.85)');
        lGrad.addColorStop(0.4, 'rgba(217, 119, 6, 0.32)');
        lGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx2d.fillStyle = lGrad;
        ctx2d.beginPath();
        ctx2d.arc(swingX, swingY, 95, 0, Math.PI * 2);
        ctx2d.fill();
      }

      // Scene 3 & 5: Flickering Diyas & Flying Crows / Poisoned Milk Mist
      if (effect === 'doli_crows' || effect === 'betrayal_milk') {
        // Flickering diya glows at bottom corners
        [0.2, 0.8].forEach((px, idx) => {
          const dx = w * px;
          const dy = h * 0.78;
          const radius = 55 + Math.sin(frameTick * 0.18 + idx) * 12;
          const dGrad = ctx2d.createRadialGradient(dx, dy, 2, dx, dy, radius);
          dGrad.addColorStop(0, 'rgba(251, 146, 60, 0.65)');
          dGrad.addColorStop(1, 'rgba(251, 146, 60, 0)');
          ctx2d.fillStyle = dGrad;
          ctx2d.beginPath();
          ctx2d.arc(dx, dy, radius, 0, Math.PI * 2);
          ctx2d.fill();
        });
      }

      // Scene 4, 6, 7: Rising Fire Embers & Crimson Curse Vortex
      if (effect === 'tehkhana_vault' || effect === 'havan_fire' || effect === 'cursed_well') {
        fireEmbers.forEach(e => {
          e.y -= e.vy;
          e.x += e.vx + Math.sin(frameTick * 0.05 + e.y * 10) * 0.0012;
          if (e.y < 0.08) {
            e.y = 0.85;
            e.x = 0.3 + Math.random() * 0.4;
          }
          ctx2d.fillStyle = effect === 'cursed_well'
            ? `rgba(239, 68, 68, ${e.alpha})`
            : `rgba(251, 146, 60, ${e.alpha})`;
          ctx2d.beginPath();
          ctx2d.arc(e.x * w, e.y * h, e.r, 0, Math.PI * 2);
          ctx2d.fill();
        });
      }

      // Scene 8 & 10: Expanding Payal Soundwave Sonar Rings & Glowing Red Eyes
      if (effect === 'pishachini_hunt' || effect === 'climax_jumpscare') {
        const cx = w * 0.5;
        const cy = h * 0.48;
        soundRings.forEach((offset, idx) => {
          const prog = ((frameTick * 0.008) + offset) % 1;
          const radius = prog * (w * 0.42);
          const alpha = (1 - prog) * 0.55;
          ctx2d.strokeStyle = `rgba(239, 68, 68, ${alpha})`;
          ctx2d.lineWidth = 2.2;
          ctx2d.beginPath();
          ctx2d.arc(cx, cy, radius, 0, Math.PI * 2);
          ctx2d.stroke();
        });

        // Glowing red eyes of Rakt Pishachini in the center corridor
        const eyePulse = 0.65 + Math.sin(frameTick * 0.15) * 0.35;
        const eyeY = h * 0.305;
        const leftEyeX = w * 0.493;
        const rightEyeX = w * 0.509;
        [leftEyeX, rightEyeX].forEach(ex => {
          const eGrad = ctx2d.createRadialGradient(ex, eyeY, 1, ex, eyeY, 14);
          eGrad.addColorStop(0, `rgba(255, 50, 50, ${eyePulse})`);
          eGrad.addColorStop(1, 'rgba(220, 38, 38, 0)');
          ctx2d.fillStyle = eGrad;
          ctx2d.beginPath();
          ctx2d.arc(ex, eyeY, 14, 0, Math.PI * 2);
          ctx2d.fill();
        });
      }

      // Scene 9: Spotlight Halos over the 4 Cursed Relics
      if (effect === 'four_relics') {
        const spots = [
          { x: 0.25, y: 0.73, label: '1. चांदी की पायल' },
          { x: 0.35, y: 0.51, label: '2. सिंदूर डिब्बी' },
          { x: 0.67, y: 0.51, label: '4. टूटा आईना' },
          { x: 0.75, y: 0.73, label: '3. लाल चूड़ियाँ' }
        ];
        const activeSpotIdx = Math.floor(frameTick / 70) % spots.length;
        spots.forEach((s, idx) => {
          const isHighlighted = idx === activeSpotIdx;
          const r = isHighlighted ? 52 : 30;
          const grad = ctx2d.createRadialGradient(s.x * w, s.y * h, 2, s.x * w, s.y * h, r);
          grad.addColorStop(0, isHighlighted ? 'rgba(251, 191, 36, 0.65)' : 'rgba(220, 38, 38, 0.3)');
          grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          ctx2d.fillStyle = grad;
          ctx2d.beginPath();
          ctx2d.arc(s.x * w, s.y * h, r, 0, Math.PI * 2);
          ctx2d.fill();
        });
      }

      // 3. Dark Horror Heartbeat Vignette around screen edges
      const vigGrad = ctx2d.createRadialGradient(w / 2, h / 2, w * 0.25, w / 2, h / 2, w * 0.65);
      vigGrad.addColorStop(0, 'rgba(0, 0, 0, 0)');
      vigGrad.addColorStop(1, 'rgba(8, 0, 2, 0.78)');
      ctx2d.fillStyle = vigGrad;
      ctx2d.fillRect(0, 0, w, h);

      // 4. Lightning Flash Overlay
      if (lightningFlashAlpha > 0.01) {
        ctx2d.fillStyle = `rgba(224, 242, 254, ${lightningFlashAlpha * 0.55})`;
        ctx2d.fillRect(0, 0, w, h);
        lightningFlashAlpha *= 0.84;
      }

      // 5. Full-Screen Jump Scare Climax Overlay (Scene 10 or Test Button)
      if (jumpScareFlashTimer > 0) {
        jumpScareFlashTimer--;
        const scareImg = document.getElementById('art-scene-5');
        if (scareImg && scareImg.complete && scareImg.naturalWidth > 0) {
          ctx2d.save();
          ctx2d.translate(w / 2 + (Math.random() - 0.5) * 34, h * 0.33 + (Math.random() - 0.5) * 34);
          ctx2d.scale(2.35, 2.35);
          ctx2d.drawImage(scareImg, -w / 2, -h / 2, w, h);
          ctx2d.restore();
        }
        ctx2d.fillStyle = 'rgba(185, 28, 28, 0.36)';
        ctx2d.fillRect(0, 0, w, h);
      }

      animFrameId = requestAnimationFrame(drawHorrorCutsceneFrame);
    }

    // ==================== 4-PLAYER LOBBY & RELICS UI ====================
    function renderLobbyUI() {
      const playerGrid = document.getElementById('player-cards-grid');
      playerGrid.innerHTML = '';
      PLAYERS.forEach(p => {
        const isSelected = p.id === selectedPlayerId;
        const card = document.createElement('button');
        card.type = 'button';
        card.className = isSelected
          ? 'text-left p-3 rounded-xl bg-red-950/60 border-2 border-red-500 shadow-lg flex flex-col gap-1 transition'
          : 'text-left p-3 rounded-xl bg-stone-900/80 border border-stone-800 hover:border-red-800 flex flex-col gap-1 transition';
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-extrabold text-sm text-white">${p.name}</span>
            <span class="text-[10px] px-2 py-0.5 rounded bg-black/70 text-amber-300 border border-amber-800/50">${p.badge}</span>
          </div>
          <span class="text-xs font-semibold text-red-400">${p.role}</span>
          <p class="text-[11px] text-stone-300 leading-snug mt-0.5">${p.perk}</p>
        `;
        card.addEventListener('click', () => {
          selectedPlayerId = p.id;
          document.getElementById('lobby-status-box').innerHTML = `✅ सर्वाइवर: <strong>${p.name}</strong> तैयार है। अपनी टीम के साथ 4 शापित चीज़ें ढूंढें!`;
          renderLobbyUI();
        });
        playerGrid.appendChild(card);
      });

      const relicsGrid = document.getElementById('relics-grid');
      relicsGrid.innerHTML = '';
      let count = 0;
      RELICS.forEach(r => {
        const found = !!collectedRelics[r.id];
        if (found) count++;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = found
          ? 'p-2.5 rounded-xl bg-amber-950/70 border-2 border-amber-500 text-left flex flex-col gap-1 transition'
          : 'p-2.5 rounded-xl bg-stone-900/90 border border-stone-800 hover:border-red-700 text-left flex flex-col gap-1 transition';
        btn.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-lg">${r.icon}</span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${found ? 'bg-emerald-800 text-white' : 'bg-stone-800 text-stone-400'}">
              ${found ? 'मिल गई ✓' : 'खोजें'}
            </span>
          </div>
          <div class="text-xs font-bold text-white leading-tight">${r.name}</div>
          <div class="text-[10px] text-amber-300/90">${r.room}</div>
        `;
        btn.addEventListener('click', () => {
          collectedRelics[r.id] = !collectedRelics[r.id];
          playPayalChime();
          renderLobbyUI();
        });
        relicsGrid.appendChild(btn);
      });

      document.getElementById('relic-collected-count').textContent = `${count} / 4 मिलीं`;
    }

    function updateNoiseSimulation(dbValue, statusText, distText, colorClass) {
      currentNoiseDb = dbValue;
      const bar = document.getElementById('noise-meter-bar');
      const label = document.getElementById('noise-status-label');
      const dist = document.getElementById('rukmini-distance-label');
      bar.style.width = `${Math.min(100, dbValue)}%`;
      bar.className = `h-full transition-all duration-200 ${colorClass}`;
      label.textContent = statusText;
      dist.textContent = distText;
    }

    // ==================== VIEW SWITCHING & TOAST ====================
    function switchView(viewName) {
      activeView = viewName;
      const views = {
        story: document.getElementById('view-story'),
        lobby: document.getElementById('view-lobby'),
        prompt: document.getElementById('view-prompt')
      };
      const tabs = {
        story: document.getElementById('tab-story-btn'),
        lobby: document.getElementById('tab-lobby-btn'),
        prompt: document.getElementById('tab-prompt-btn')
      };

      Object.keys(views).forEach(k => {
        if (k === viewName) {
          views[k].classList.remove('hidden');
          views[k].classList.add('flex');
        } else {
          views[k].classList.add('hidden');
          views[k].classList.remove('flex');
        }
      });

      tabs.story.className = viewName === 'story'
        ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-700 text-white border border-red-500 transition'
        : 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-stone-900/90 text-stone-300 border border-stone-700 hover:border-red-700 transition';
      tabs.lobby.className = viewName === 'lobby'
        ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-700 text-white border border-red-500 transition'
        : 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-stone-900/90 text-stone-300 border border-stone-700 hover:border-red-700 transition';
      tabs.prompt.className = viewName === 'prompt'
        ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-600 text-black border border-amber-400 transition'
        : 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-950/80 text-amber-300 border border-amber-700/70 hover:bg-amber-900/80 transition';

      if (viewName !== 'story' && isPlaying) {
        isPlaying = false;
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        updatePlayPauseButton();
      }
      if (viewName === 'story') {
        setTimeout(resizeCanvas, 50);
      }
    }

    let toastTimeoutId = null;
    function showToast(msg) {
      const banner = document.getElementById('toast-banner');
      banner.textContent = msg;
      banner.classList.remove('hidden');
      if (toastTimeoutId) clearTimeout(toastTimeoutId);
      toastTimeoutId = setTimeout(() => {
        banner.classList.add('hidden');
      }, 3200);
    }

    // ==================== INITIALIZATION & EVENT LISTENERS ====================
    window.onload = function () {
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      renderChapterPills();
      loadCurrentBeat(false);
      renderLobbyUI();

      if (animFrameId) cancelAnimationFrame(animFrameId);
      animFrameId = requestAnimationFrame(drawHorrorCutsceneFrame);

      // Top Navigation Tabs
      document.getElementById('tab-story-btn').addEventListener('click', () => switchView('story'));
      document.getElementById('tab-lobby-btn').addEventListener('click', () => switchView('lobby'));
      document.getElementById('tab-prompt-btn').addEventListener('click', () => switchView('prompt'));

      // Audio Toggle
      document.getElementById('audio-toggle-btn').addEventListener('click', () => {
        audioEnabled = !audioEnabled;
        const btn = document.getElementById('audio-toggle-btn');
        btn.textContent = audioEnabled ? '🔊 आवाज़: ON' : '🔇 आवाज़: OFF';
        btn.className = audioEnabled
          ? 'px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-stone-900 text-emerald-400 border border-emerald-800/70 hover:bg-stone-800 transition'
          : 'px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-stone-900 text-stone-400 border border-stone-700 hover:bg-stone-800 transition';
        if (droneGain) droneGain.gain.value = audioEnabled ? 0.05 : 0;
        if (rainGainNode) rainGainNode.gain.value = audioEnabled ? 0.035 : 0;
        if (!audioEnabled && 'speechSynthesis' in window) {
          window.speechSynthesis.cancel();
        }
      });

      // Start Cutscene Overlay Button
      document.getElementById('start-movie-btn').addEventListener('click', () => {
        hasStartedOnce = true;
        document.getElementById('start-cutscene-overlay').classList.add('hidden');
        ensureAudioContext();
        isPlaying = true;
        updatePlayPauseButton();
        loadCurrentBeat(true);
        startBeatLoop();
      });

      document.getElementById('overlay-skip-to-lobby-btn').addEventListener('click', () => {
        hasStartedOnce = true;
        document.getElementById('start-cutscene-overlay').classList.add('hidden');
        ensureAudioContext();
        playIronGateSlam();
        switchView('lobby');
      });

      // Skip Story Button (Top Right)
      document.getElementById('skip-story-btn').addEventListener('click', () => {
        ensureAudioContext();
        playIronGateSlam();
        showToast('⏭️ स्टोरी स्किप कर दी गई — आप सीधे ठाकुर हवेली लॉबी में हैं!');
        switchView('lobby');
      });

      // Jump Scare Test Button
      document.getElementById('trigger-jumpscare-btn').addEventListener('click', () => {
        ensureAudioContext();
        playJumpScareScream();
      });

      // Pace Toggle Button
      document.getElementById('pace-toggle-btn').addEventListener('click', () => {
        slowHorrorPace = !slowHorrorPace;
        document.getElementById('pace-toggle-btn').textContent = slowHorrorPace
          ? '⏱️ रफ़्तार: सिनेमैटिक (Slow Horror)'
          : '⚡ रफ़्तार: तेज़ प्रीव्यू (Fast Pace)';
        loadCurrentBeat(false);
      });

      // Playback Controls
      document.getElementById('play-pause-btn').addEventListener('click', () => {
        if (!hasStartedOnce) {
          hasStartedOnce = true;
          document.getElementById('start-cutscene-overlay').classList.add('hidden');
        }
        ensureAudioContext();
        isPlaying = !isPlaying;
        updatePlayPauseButton();
        if (isPlaying) {
          loadCurrentBeat(true);
          startBeatLoop();
        } else if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
        }
      });

      document.getElementById('prev-scene-btn').addEventListener('click', () => {
        jumpToChapter(currentChapterIndex - 1);
      });

      document.getElementById('next-scene-btn').addEventListener('click', () => {
        jumpToChapter(currentChapterIndex + 1);
      });

      document.getElementById('next-beat-btn').addEventListener('click', () => {
        if (!hasStartedOnce) {
          hasStartedOnce = true;
          document.getElementById('start-cutscene-overlay').classList.add('hidden');
        }
        ensureAudioContext();
        isPlaying = true;
        updatePlayPauseButton();
        advanceToNextBeat();
        startBeatLoop();
      });

      // Sound Test Buttons
      document.getElementById('sfx-payal-btn').addEventListener('click', () => {
        ensureAudioContext();
        playPayalChime();
      });
      document.getElementById('sfx-thunder-btn').addEventListener('click', () => {
        ensureAudioContext();
        playThunderCrash();
      });
      document.getElementById('sfx-gate-btn').addEventListener('click', () => {
        ensureAudioContext();
        playIronGateSlam();
      });

      // Lobby Buttons
      document.getElementById('back-to-story-btn').addEventListener('click', () => {
        switchView('story');
      });

      document.getElementById('sim-walk-btn').addEventListener('click', () => {
        ensureAudioContext();
        updateNoiseSimulation(15, 'शांत (15 dB) — सुरक्षित', '26 मीटर दूर (रुक्मिणी को भनक नहीं)', 'bg-emerald-500');
      });

      document.getElementById('sim-run-btn').addEventListener('click', () => {
        ensureAudioContext();
        playPayalChime();
        updateNoiseSimulation(58, 'सावधान (58 dB) — कदमों की आहट!', '9 मीटर दूर (पायल की आवाज़ पास आ रही है!)', 'bg-amber-500');
      });

      document.getElementById('sim-scream-btn').addEventListener('click', () => {
        ensureAudioContext();
        playJumpScareScream();
        updateNoiseSimulation(96, 'खतरा (96 dB) — रुक्मिणी ने सुन लिया!!', '0 मीटर — आपके ठीक पीछे!!', 'bg-red-600');
        showToast('🩸 रुक्मिणी ने आपकी आवाज़ सुन ली! बिल्कुल शांत रहें!');
      });

      document.getElementById('burn-all-ritual-btn').addEventListener('click', () => {
        ensureAudioContext();
        RELICS.forEach(r => { collectedRelics[r.id] = true; });
        renderLobbyUI();
        playThunderCrash();
        showToast('🔥 चारों शापित चीज़ें सूखे कुएं में भस्म हुईं! ठाकुर हवेली का मुख्य दरवाज़ा खुल गया!');
      });

      // Copy AI Studio Prompt Button
      document.getElementById('copy-prompt-btn').addEventListener('click', () => {
        const textarea = document.getElementById('ai-studio-prompt-textarea');
        textarea.select();
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(textarea.value).then(() => {
              showToast('✅ Google AI Studio का प्रॉम्प्ट कॉपी हो गया! अब AI Studio में पेस्ट करें।');
            }).catch(() => {
              document.execCommand('copy');
              showToast('✅ Google AI Studio का प्रॉम्प्ट कॉपी हो गया!');
            });
          } else {
            document.execCommand('copy');
            showToast('✅ Google AI Studio का प्रॉम्प्ट कॉपी हो गया!');
          }
        } catch (err) {
          showToast('प्रॉम्प्ट टेक्स्ट बॉक्स से कॉपी करें।');
        }
      });
    };
  </script>
</body>
