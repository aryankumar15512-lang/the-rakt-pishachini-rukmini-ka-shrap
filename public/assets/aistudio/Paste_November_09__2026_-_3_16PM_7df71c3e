            </p>

            <!-- Progress bar for current beat -->
            <div class="w-full h-1.5 bg-stone-900 rounded-full overflow-hidden mt-0.5">
              <div id="beat-progress-bar" class="h-full bg-gradient-to-r from-red-700 via-red-500 to-amber-500 transition-all duration-150" style="width: 0%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Cutscene Playback & Sound Effect Controls -->
