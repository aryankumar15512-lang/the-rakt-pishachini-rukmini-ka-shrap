        <canvas id="horror-canvas" class="w-full h-full block"></canvas>

        <!-- Top-Left Chapter Info Overlay -->
        <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-10 pointer-events-none flex flex-col gap-1 max-w-[70%]">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/80 border border-red-800/70 backdrop-blur-sm w-fit">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            <span id="hud-chapter-time" class="text-[11px] font-mono uppercase tracking-wider text-red-400">00:00 - 01:00 • अध्याय 1</span>
          </div>
          <h2 id="hud-chapter-title" class="text-base sm:text-xl md:text-2xl font-extrabold text-white horror-glow drop-shadow-md">
            सीन 1: काली घाटी और भटकती कार
          </h2>
        </div>

        <!-- Top-Right "Skip Story ⏭️" Button (As designed in user's Google Doc) -->
        <div class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 flex items-center gap-2">
          <button id="trigger-jumpscare-btn" type="button" class="px-2.5 py-1.5 rounded-lg bg-red-950/85 hover:bg-red-800 text-red-200 border border-red-700/70 text-xs font-semibold backdrop-blur-sm transition">
