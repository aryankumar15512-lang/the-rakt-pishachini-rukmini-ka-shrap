          </button>
          <button id="next-beat-btn" type="button" class="px-3 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-amber-300 border border-amber-800/70 text-xs font-semibold transition">
            अगला संवाद ⏩
          </button>
          <button id="next-scene-btn" type="button" class="px-3 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-stone-200 border border-stone-700 text-xs font-semibold transition">
            अगला सीन ⏭️
          </button>
        </div>

        <!-- Instant Horror Sound Triggers -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[11px] text-stone-400 mr-1 hidden sm:inline">लाइव हॉरर साउंड टेस्ट:</span>
          <button id="sfx-payal-btn" type="button" class="px-2.5 py-1 rounded-md bg-stone-900 hover:bg-red-950 text-amber-300 border border-stone-700 text-xs transition">
            🔔 पायल की छन-छन
          </button>
          <button id="sfx-thunder-btn" type="button" class="px-2.5 py-1 rounded-md bg-stone-900 hover:bg-red-950 text-sky-300 border border-stone-700 text-xs transition">
            ⚡ बिजली कड़कना
          </button>
          <button id="sfx-gate-btn" type="button" class="px-2.5 py-1 rounded-md bg-stone-900 hover:bg-red-950 text-stone-300 border border-stone-700 text-xs transition">
            🚪 लोहे का गेट बंद
          </button>
        </div>
      </div>
